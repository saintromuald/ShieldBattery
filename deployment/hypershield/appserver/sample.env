# HyperShield application images. Publish them with the HyperShield server images workflow.
HYPERSHIELD_SERVER_IMAGE=ghcr.io/saintromuald/hypershield-server
HYPERSHIELD_SERVER_RS_IMAGE=ghcr.io/saintromuald/hypershield-server-rs
SB_VERSION=latest

# Replace every REPLACE_ME value before starting. Generate passwords locally with a secrets manager.
POSTGRES_SUPER_PASSWORD=REPLACE_ME
SB_DB=hypershield
SB_DB_NAME=hypershield
SB_DB_USER=shieldbattery
SB_DB_PASSWORD=REPLACE_ME
SB_DB_POOL_MAX=10
SB_JWT_SECRET=REPLACE_ME

# Replace hypershield.example with the registered domain.
SB_LETSENCRYPT_EMAIL=admin@hypershield.example
SB_VIRTUAL_HOST=play.hypershield.example
SB_CANONICAL_HOST=https://play.hypershield.example
SB_GQL_ORIGIN=https://gql.play.hypershield.example
SB_GQL_VIRTUAL_HOST=gql.play.hypershield.example
SB_DEEP_LINK_SCHEME=hypershield

SB_SESSION_TTL=2592000
SB_ALLOW_UNSIGNED_SIGNUP=true
SB_REQUIRE_CLIENT_ATTESTATION=false
SB_MAP_PARSER_MAX_CONCURRENT=1
SB_REPLAY_WORKER_CONCURRENCY=1

# Account verification and recovery require real Mailgun values.
SB_MAILGUN_KEY=REPLACE_ME
SB_MAILGUN_DOMAIN=mg.play.hypershield.example
SB_MAILGUN_FROM=HyperShield <support@play.hypershield.example>

# DigitalOcean Spaces. Keep replays and bug reports private; do not add cdnHost.
SB_FILE_STORE={"doSpaces":{"endpoint":"nyc3.digitaloceanspaces.com","accessKeyId":"REPLACE_ME","secretAccessKey":"REPLACE_ME","bucket":"angelicgaming-hypershield-files"}}

# HyperShield's independent rally-point2 tenant.
SB_RP2_COORDINATOR_URL=https://rp2.play.hypershield.example
SB_RP2_TENANT=hypershield
SB_RP2_CLIENT_KEY=REPLACE_ME
SB_RP2_RELAY_SERVER_NAME=localhost
SB_RP2_ROLLBACK=false

# Optional integrations stay disabled for the initial deployment.
#SB_ANALYTICS_ID=
#SB_DATADOG_KEY=
#SB_DISCORD_WEBHOOK_URL=
#SB_DISABLE_CRAWLERS=true

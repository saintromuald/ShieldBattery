HYPERSHIELD_COORDINATOR_IMAGE=ghcr.io/saintromuald/rp2-coordinator
# Pin a tested commit SHA or digest for production instead of latest.
RP2_REF=:latest
HYPERSHIELD_RELAY_IMAGE=ghcr.io/saintromuald/rp2-relay
RELAY_VERSION=latest
RELAY_PUBLIC_ADDRESS=159.203.114.113

COORDINATOR_LISTEN=[::]:14910
COORDINATOR_BOOTSTRAP_SECRET=REPLACE_ME
COORDINATOR_REGIONS=/config/regions.single.json
# Single-region mode accepts the out-of-band relay; no provisioned-relay ledger is used.
#COORDINATOR_RELAY_LEDGER=/data/relay-ledger.sqlite

# Replace hypershield.example with the registered domain. Do not proxy this service.
COORDINATOR_ACME_DOMAIN=rp2.play.hypershield.example
COORDINATOR_ACME_CONTACT=admin@hypershield.example
COORDINATOR_ACME_CACHE=/data/acme
# Use this only while testing certificate issuance, then remove it and clear data/acme.
#COORDINATOR_ACME_STAGING=true

# Preserve AWS provisioning for a later multi-region expansion.
#COORDINATOR_PROVISION_ECS_CONFIG=/config/ecs.json
#AWS_ACCESS_KEY_ID=REPLACE_ME
#AWS_SECRET_ACCESS_KEY=REPLACE_ME

COORDINATOR_RELAY_IDLE_SECS=600
COORDINATOR_WARM_TTL_SECS=600
COORDINATOR_MAX_SESSIONS=40

COORDINATOR_TENANTS=/config/tenants.json
COORDINATOR_TENANT_HYPERSHIELD_SIGNING_KEY=REPLACE_ME

# Flight recording is optional and disabled until a separate private bucket is configured.
#COORDINATOR_FLIGHT_STORE=/config/flight-store.json
#FLIGHT_STORE_ACCESS_KEY_ID=
#FLIGHT_STORE_SECRET_ACCESS_KEY=

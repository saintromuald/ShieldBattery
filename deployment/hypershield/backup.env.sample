# Install as /opt/hypershield/backup.env, owned by root with mode 0600.
# The script creates separate app and coordinator repositories inside this base location.
RESTIC_REPOSITORY_BASE=s3:https://nyc3.digitaloceanspaces.com/angelicgaming-hypershield-backups
RESTIC_PASSWORD_FILE=/opt/hypershield/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Required only on the application host. Use a read-only key for the application bucket.
# The backup key above writes both restic data and object copies in the backup bucket.
OBJECT_STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
OBJECT_STORAGE_APPLICATION_BUCKET=angelicgaming-hypershield-files
OBJECT_STORAGE_BACKUP_BUCKET=angelicgaming-hypershield-backups
OBJECT_STORAGE_READER_ACCESS_KEY_ID=REPLACE_ME
OBJECT_STORAGE_READER_SECRET_ACCESS_KEY=REPLACE_ME
